<?xml version="1.0" encoding="utf-8"?>
<!-- G4 (galería): rutas que el FileProvider puede exponer al compartir/abrir.
     root-path cubre rutas absolutas arbitrarias (caché del selector, Descargas
     en Android 9); las demás cubren los directorios propios de la app. -->
<paths>
    <root-path name="root" path="/" />
    <external-path name="external" path="." />
    <external-files-path name="ext_files" path="." />
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
</paths>
